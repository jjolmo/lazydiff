{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schemas/refs/heads/main/src/tauri.conf.schema.json",
  "productName": "LazyDiff",
  "version": "0.11.0",
  "identifier": "com.lazydiff.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run kill-port; npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LazyDiff",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
